# ── Firebase (client) ─────────────────────────────────────────────
# Create a Firebase project → Build → Authentication → enable Google sign-in
# → Project settings → Web app → copy config.
NEXT_PUBLIC_FIREBASE_API_KEY=AIza...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef

# ── AI provider (server-side, never exposed) ─────────────────────
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# ── Server-side Firebase token verification ───────────────────────
# Same value as NEXT_PUBLIC_FIREBASE_API_KEY above.
FIREBASE_WEB_API_KEY=AIza...