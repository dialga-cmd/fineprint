rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if owns(uid);
    }

    match /conversations/{id} {
      allow read, update, delete: if owns(resource.data.ownerId);
      allow create: if owns(request.resource.data.ownerId);

      match /messages/{mid} {
        allow read, create, update, delete: if owns(get(/databases/$(database)/documents/conversations/$(id)).data.ownerId);
      }
    }
  }
}